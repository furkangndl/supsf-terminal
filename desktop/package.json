{
  "name": "terminalo-desktop",
  "productName": "Terminalo",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "package": "electron-packager . Terminalo --platform=darwin --out=dist --overwrite --icon=icon.icns --app-bundle-id=com.furkangundel.terminalo --no-asar --ignore=^/dist",
    "install-app": "npm run package && chmod +x dist/Terminalo-darwin-*/Terminalo.app/Contents/Resources/app/node_modules/node-pty/prebuilds/darwin-*/spawn-helper && rm -rf ~/Applications/Terminalo.app && cp -R dist/Terminalo-darwin-*/Terminalo.app ~/Applications/",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/darwin-*/spawn-helper || true"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0"
  }
}
