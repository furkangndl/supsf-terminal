{
  "name": "terminalo-desktop",
  "productName": "Terminalo",
  "version": "0.1.0",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "prepackage": "node scripts/write-root.cjs",
    "package": "electron-packager . Terminalo --platform=darwin --out=dist --overwrite --icon=icon.icns --app-bundle-id=com.furkangundel.terminalo --no-asar --ignore=^/dist",
    "package:win": "electron-packager . Terminalo --platform=win32 --out=dist --overwrite --icon=icon.ico --no-asar --ignore=^/dist",
    "install-app": "npm run package && node scripts/install-app.cjs",
    "postinstall": "node scripts/fix-spawn-helper.cjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "45.0.0"
  }
}
